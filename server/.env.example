SCHEMA_DIR=src/db
NODE_OPTIONS=--import\ tsx/esm
# JWT Secret - 必须设置为强随机字符串（生产环境）
# 生成方法: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-change-this-in-production

# 数据库文件路径，相对 server/ 目录（默认 ../data/finance.db）
# 当前分支 cw0523 用独立文件，与原项目 cw 隔离
DB_PATH=../data/finance-0523.db

# 开发环境跳过软件授权校验（生产环境切勿启用）
# LICENSE_SKIP=true
